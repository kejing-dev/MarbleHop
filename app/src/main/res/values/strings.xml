    <!-- rules (content.rulesPage) -->
    <string name="rules_title">How it works</string>
    <string name="rules_1">Goal: move all 10 of your marbles into the camp straight across.</string>
    <string name="rules_2">One marble per turn: step to an empty hole next to it, or hop over a neighbour into the empty hole behind.</string>
    <string name="rules_3">After a hop you can keep hopping, as far as the chain goes.</string>
    <string name="rules_4">Pass through other camps, but don\'t stop there. A marble that\'s home stays home.</string>
    <string name="rules_5">Someone squatting in your camp? Get 7 or more in with every free hole filled, and you win.</string>
    <string name="rules_step">step</string>
    <string name="rules_hop">hop</string>
    <!-- how to play (B19: one line per main action, gesture and controller) -->
    <string name="how_to_title">How to play</string>
    <string name="how_to_drag">Pinch a marble (or hold the trigger), drag to a lit hole, let go.</string>
    <string name="how_to_tap">Or tap a marble, tap a lit hole, then tap it again or press Drop.</string>
    <string name="how_to_arrows">Arrows move the pick when holes are hard to hit.</string>

